{
  "name": "jiying-workshop",
  "private": false,
  "version": "0.2.0",
  "description": "稽影 — AI Agent 编排工坊。稽察审视，追影溯源。界定每一次AI参与的价值边界。",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Vane1981-2011",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Vane1981-2011/jiying",
  "bugs": "https://github.com/Vane1981-2011/jiying/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vane1981-2011/jiying.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.7",
    "@ai-sdk/openai": "^4.0.11",
    "@noble/ed25519": "^3.1.0",
    "ai": "^7.0.22",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.1.1",
    "vitest": "^3.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.jiying.app",
    "productName": "稽影",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  }
}
